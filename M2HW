/* MIDI */

function readU16(data, p) {
    return (
        (data[p] << 8) |
        data[p + 1]
    );
}


function readU32(data, p) {
    return (
        ((data[p] << 24) >>> 0) |
        (data[p + 1] << 16) |
        (data[p + 2] << 8) |
        data[p + 3]
    ) >>> 0;
}


function readString(data, p, length) {

    let result = "";

    for (let i = 0; i < length; i++) {
        result += String.fromCharCode(
            data[p + i]
        );
    }

    return result;
}


function readVarLen(data, state) {

    let value = 0;

    while (true) {

        const b = data[state.pos++];

        value =
            (value << 7) |
            (b & 0x7f);

        if (!(b & 0x80))
            break;
    }

    return value;
}


/* MIDI PARSER */

function parseMIDI(buffer) {

    const data = new Uint8Array(buffer);

    let pos = 0;

    if (
        readString(data, 0, 4) !== "MThd"
    ) {
        throw new Error("not a midi file");
    }

    const headerLength =
        readU32(data, 4);

    const format =
        readU16(data, 8);

    const trackCount =
        readU16(data, 10);

    const division =
        readU16(data, 12);

    if (division & 0x8000) {
        throw new Error("SMPTE midi timing not supported");
    }

    const ticksPerQuarter = division;

    pos = 8 + headerLength;

    const tracks = [];
    const allNotes = [];
    const tempoEvents = [];

    for (
        let trackIndex = 0;
        trackIndex < trackCount;
        trackIndex++
    ) {

        if (
            readString(data, pos, 4) !== "MTrk"
        ) {
            throw new Error("bad midi track");
        }

        const trackLength =
            readU32(data, pos + 4);

        pos += 8;

        const trackEnd =
            pos + trackLength;

        let tick = 0;
        let runningStatus = null;

        const activeNotes = new Map();

        while (pos < trackEnd) {

            const state = { pos };

            const delta =
                readVarLen(data, state);

            pos = state.pos;

            tick += delta;

            let status = data[pos];

            if (status < 0x80) {

                if (runningStatus === null) {
                    throw new Error("bad running status");
                }

                status = runningStatus;

            } else {

                pos++;
                runningStatus = status;
            }


            /* META */

            if (status === 0xff) {

                const metaType = data[pos++];

                const state2 = { pos };

                const length =
                    readVarLen(data, state2);

                pos = state2.pos;

                if (
                    metaType === 0x51 &&
                    length === 3
                ) {

                    const microseconds =
                        (data[pos] << 16) |
                        (data[pos + 1] << 8) |
                        data[pos + 2];

                    tempoEvents.push({
                        tick,
                        microseconds
                    });
                }

                pos += length;

                continue;
            }


            /* SYSEX */

            if (
                status === 0xf0 ||
                status === 0xf7
            ) {

                const state2 = { pos };

                const length =
                    readVarLen(data, state2);

                pos =
                    state2.pos + length;

                continue;
            }


            const command =
                status & 0xf0;

            const channel =
                status & 0x0f;


            /* 2 BYTE */

            if (
                command === 0x80 ||
                command === 0x90 ||
                command === 0xa0 ||
                command === 0xb0 ||
                command === 0xe0
            ) {

                const note =
                    data[pos++];

                const velocity =
                    data[pos++];


                if (
                    command === 0x90 &&
                    velocity > 0
                ) {

                    const key =
                        channel + ":" + note;

                    activeNotes.set(
                        key,
                        {
                            note,
                            velocity,
                            startTick: tick,
                            channel
                        }
                    );
                }

                else if (
                    command === 0x80 ||
                    (
                        command === 0x90 &&
                        velocity === 0
                    )
                ) {

                    const key =
                        channel + ":" + note;

                    const active =
                        activeNotes.get(key);

                    if (active) {

                        allNotes.push({

                            note: active.note,
                            velocity: active.velocity,
                            startTick: active.startTick,
                            endTick: tick,
                            channel: active.channel

                        });

                        activeNotes.delete(key);
                    }
                }
            }


            /* 1 BYTE */

            else if (
                command === 0xc0 ||
                command === 0xd0
            ) {

                pos++;
            }
        }

        tracks.push({
            index: trackIndex
        });

        pos = trackEnd;
    }


    if (
        !tempoEvents.some(
            e => e.tick === 0
        )
    ) {

        tempoEvents.push({
            tick: 0,
            microseconds: 500000
        });
    }


    tempoEvents.sort(
        (a, b) =>
            a.tick - b.tick
    );


    const tempoMap = [];

    for (const event of tempoEvents) {

        if (
            tempoMap.length &&
            tempoMap[
                tempoMap.length - 1
            ].tick === event.tick
        ) {

            tempoMap[
                tempoMap.length - 1
            ] = event;

        } else {

            tempoMap.push(event);
        }
    }


    function tickToSeconds(targetTick) {

        let seconds = 0;
        let previousTick = 0;
        let previousTempo = 500000;

        for (const tempo of tempoMap) {

            if (
                tempo.tick >
                targetTick
            ) {
                break;
            }

            const deltaTicks =
                tempo.tick -
                previousTick;

            seconds +=
                deltaTicks *
                previousTempo /
                1000000 /
                ticksPerQuarter;

            previousTick =
                tempo.tick;

            previousTempo =
                tempo.microseconds;
        }

        const remainingTicks =
            targetTick -
            previousTick;

        seconds +=
            remainingTicks *
            previousTempo /
            1000000 /
            ticksPerQuarter;

        return seconds;
    }


    for (const note of allNotes) {

        note.start =
            tickToSeconds(
                note.startTick
            );

        note.end =
            tickToSeconds(
                note.endTick
            );

        note.duration =
            Math.max(
                0,
                note.end -
                note.start
            );
    }


    allNotes.sort(
        (a, b) =>
            a.start - b.start
    );


    return {
        format,
        tracks,
        notes: allNotes,
        tempoMap,
        ticksPerQuarter
    };
}


