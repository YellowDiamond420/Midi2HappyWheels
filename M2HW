/* NOTE OBJECT */

function makeNoteShape(note, settings) {

    let x =
        settings.startX +
        note.start *
        settings.xScale;

    let y =
        settings.startY -
        (note.note - 60) *
        settings.yScale;

    if (settings.channelLayers) {
        y -= note.channel * 150;
    }

    let width =
        settings.noteWidth;

    let height =
        settings.noteHeight;

    if (settings.durationWidth) {

        width +=
            note.duration *
            settings.xScale;
    }

    if (settings.velocitySize) {

        const multiplier =
            0.5 +
            note.velocity / 127;

        width *= multiplier;
        height *= multiplier;
    }

    width = Math.max(5, width);
    height = Math.max(5, height);

    return (
        `        <sh ` +
        `t="${settings.shapeType}" ` +
        `p0="${x.toFixed(2)}" ` +
        `p1="${y.toFixed(2)}" ` +
        `p2="${width.toFixed(2)}" ` +
        `p3="${height.toFixed(2)}" ` +
        `p4="0" ` +
        `p5="t" ` +
        `p6="f" ` +
        `p7="1" ` +
        `p8="${settings.objectColor}" ` +
        `p9="-1" ` +
        `p10="100" ` +
        `p11="1"/>`
    );
}


/* XML */

function generateXML(parsed, settings, filename) {

    const notes = parsed.notes;

    let maxX = settings.startX;
    let maxY = settings.startY;

    for (const note of notes) {

        const x =
            settings.startX +
            note.start *
            settings.xScale;

        let y =
            settings.startY -
            (note.note - 60) *
            settings.yScale;

        if (settings.channelLayers) {
            y -= note.channel * 150;
        }

        maxX = Math.max(maxX, x);
        maxY = Math.max(maxY, y);
    }


    const levelWidth =
        Math.max(
            3000,
            Math.ceil(maxX + 1000)
        );

    const levelHeight =
        Math.max(
            5100,
            Math.ceil(maxY + 1000)
        );


    const xml = [];

    xml.push("<levelXML>");

    xml.push(
        `    <info v="1.99" rv="1.98.4" x="${levelWidth}" y="${levelHeight}" c="1" f="f" h="f" bg="0" bgc="16777215" e="1"/>`
    );

    xml.push("    <shapes>");


    if (settings.includeDefaults) {
        addDefaults(xml);
    }


    for (const note of notes) {

        xml.push(
            makeNoteShape(
                note,
                settings
            )
        );
    }


    xml.push("    </shapes>");

    xml.push("    <specials>");


    if (settings.includeText) {

        const credit =
            filename +
            " converted to happy wheels using Midi2HappyWheels made by yellowDiamond420";

        xml.push(
            `        <sp t="16" p0="1371" p1="5347" p2="0" p3="0" p4="2" p5="15" p6="1" p8="100">`
        );

        xml.push(
            `            <p7><![CDATA[${credit.replace(
                /]]>/g,
                "]]&gt;"
            )}]]></p7>`
        );

        xml.push(
            `        </sp>`
        );
    }


    xml.push("    </specials>");

    xml.push("    <triggers>");


    if (settings.includeDefaults) {

        xml.push(
            `        <t x="1968" y="5417" w="100" h="100" a="0" b="1" t="1" r="1" sd="f" d="0"/>`
        );
    }


    xml.push("    </triggers>");

    xml.push("</levelXML>");

    return xml.join("\n");
}


/* CONVERT */

async function convertMidi() {

    const input =
        document.getElementById("midiFile");

    const status =
        document.getElementById("status");


    if (!input.files.length) {

        status.textContent =
            "pick a midi first";

        return;
    }


    try {

        status.textContent =
            "doing midi stuff...";


        const file =
            input.files[0];

        const buffer =
            await file.arrayBuffer();

        const parsed =
            parseMIDI(buffer);

        currentParsed =
            parsed;


        const settings = {

            xScale:
                Number(
                    document.getElementById(
                        "xScale"
                    ).value
                ),

            yScale:
                Number(
                    document.getElementById(
                        "yScale"
                    ).value
                ),

            startX:
                Number(
                    document.getElementById(
                        "startX"
                    ).value
                ),

            startY:
                Number(
                    document.getElementById(
                        "startY"
                    ).value
                ),

            noteWidth:
                Number(
                    document.getElementById(
                        "noteWidth"
                    ).value
                ),

            noteHeight:
                Number(
                    document.getElementById(
                        "noteHeight"
                    ).value
                ),

            shapeType:
                Number(
                    document.getElementById(
                        "shapeType"
                    ).value
                ),

            objectColor:
                Number(
                    document.getElementById(
                        "objectColor"
                    ).value
                ),

            velocitySize:
                document.getElementById(
                    "velocitySize"
                ).checked,

            durationWidth:
                document.getElementById(
                    "durationWidth"
                ).checked,

            channelLayers:
                document.getElementById(
                    "channelLayers"
                ).checked,

            includeDefaults:
                document.getElementById(
                    "includeDefaults"
                ).checked,

            includeText:
                document.getElementById(
                    "includeText"
                ).checked
        };


        generatedXML =
            generateXML(
                parsed,
                settings,
                file.name
            );


        document.getElementById(
            "output"
        ).value =
            generatedXML;


        document.getElementById(
            "noteCount"
        ).textContent =
            parsed.notes.length;


        document.getElementById(
            "trackCount"
        ).textContent =
            parsed.tracks.length;


        document.getElementById(
            "tempoCount"
        ).textContent =
            parsed.tempoMap.length;


        let length = 0;

        for (const note of parsed.notes) {

            length =
                Math.max(
                    length,
                    note.end
                );
        }


        document.getElementById(
            "lengthStat"
        ).textContent =
            length.toFixed(2) + "s";


        status.textContent =
            "converted " +
            file.name +
            " (" +
            parsed.notes.length +
            " notes)";

    } catch (error) {

        console.error(error);

        status.textContent =
            "error: " +
            error.message;
    }
}


/* DOWNLOAD */

function downloadXML() {

    if (!generatedXML) {

        alert("convert something first");

        return;
    }


    const blob =
        new Blob(
            [generatedXML],
            {
                type: "application/xml"
            }
        );


    const url =
        URL.createObjectURL(blob);


    const a =
        document.createElement("a");


    a.href = url;

    a.download =
        "Midi2HappyWheels.xml";


    document.body.appendChild(a);

    a.click();

    a.remove();

    URL.revokeObjectURL(url);
}


/* FILE SELECTED */

document
    .getElementById("midiFile")
    .addEventListener(
        "change",
        function() {

            if (!this.files.length)
                return;

            document.getElementById(
                "status"
            ).textContent =
                this.files[0].name +
                " selected";
        }
    );

</script>

